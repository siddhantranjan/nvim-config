# ================================================================================================
# Per-project clangd config, written by `:CppInit`. clangd reloads it on save.
# Reference: https://clangd.llvm.org/config
#
# BEST RESULTS: give clangd the real build flags. With CMake:
#     cmake -S . -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
# clangd finds build/compile_commands.json on its own. For a tiny project without a build
# system, a compile_flags.txt (one flag per line) in the root works too.
#
# NOTE: `CompileFlags.Add` is appended to EVERY compile command, including ones from
# compile_commands.json. If your build already sets -std, delete the -std entries below so
# they don't override it.
# ================================================================================================

# C++ sources and headers. (If this is a C project, drop `h` from this list -- otherwise C
# headers get parsed with -std=c++20.)
If:
  PathMatch: .*\.(cc|cpp|cxx|c\+\+|hh|hpp|hxx|h\+\+|ipp|tpp|inl|h)
CompileFlags:
  Add: [-std=c++20, -Wall, -Wextra]
  # macOS: Apple clang/libc++ has no <bits/stdc++.h>. To use it, install GCC
  # (`brew install gcc`) and let clangd borrow its headers:
  # Compiler: g++-15
---
# C sources.
If:
  PathMatch: .*\.c
CompileFlags:
  Add: [-std=c17, -Wall, -Wextra]
---
Diagnostics:
  # "Included header X is not used directly". Set to None if it's too chatty.
  UnusedIncludes: Strict
  # "No header providing X is directly included". Off by default; Strict to enable.
  MissingIncludes: None
  ClangTidy:
    Add:
      - bugprone-*
      - performance-*
      - modernize-use-nullptr
      - modernize-use-override
    Remove:
      - bugprone-easily-swappable-parameters

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  Designators: true

Hover:
  ShowAKA: true
