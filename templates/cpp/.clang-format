# ================================================================================================
# Default C / C++ style for this Neovim config.
#
# Used in two ways:
#   * conform.nvim passes it to clang-format (`--style=file:<this file>`) whenever the file
#     being formatted has no .clang-format / _clang-format of its own in any parent directory.
#     A project's own .clang-format always wins.
#   * `:CppInit` copies it into a project root so the style is pinned there (and so clangd's
#     own edits -- code actions, header insertion, rename -- use it too).
#
# Kept in step with the buffer options set for c/cpp in lua/config/autocmds.lua (4 spaces,
# 100 columns, cinoptions), so what you type and what you get on save agree.
#
# Only long-standing keys are used so that older clang-format binaries don't reject the file.
# Reference: https://clang.llvm.org/docs/ClangFormatStyleOptions.html
# ================================================================================================
---
BasedOnStyle: LLVM
Standard: Latest

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4          # `public:` lines up with `class`
IndentCaseLabels: true            # `case` indented inside `switch`
NamespaceIndentation: None        # namespace bodies are not indented

# Line length
ColumnLimit: 100

# Pointers / references: `int* p`, `const std::string& s`
DerivePointerAlignment: false
PointerAlignment: Left

# Short constructs
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortLambdasOnASingleLine: All
AllowShortCaseLabelsOnASingleLine: false

# Braces
BreakBeforeBraces: Attach

# Includes are sorted within each blank-line-separated block (LLVM default).

# Misc
FixNamespaceComments: true
SpaceAfterTemplateKeyword: true
MaxEmptyLinesToKeep: 1
...
